{
  "expo": {
    "name": "Found",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/found-app-icon-v2.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/found-app-icon-v2.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F2",
        "foregroundImage": "./assets/images/found-logo-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.consjck3.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/found-app-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F2",
          "image": "./assets/images/found-logo-v2.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Found use sua localização para mostrá-la a quem escaneou seu QR Code."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Permita que o Found salve imagens de QR Code na sua galeria.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#405078",
          "defaultChannel": "location-found"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1951c102-caaa-404e-94aa-c92e6f27da1d"
      }
    }
  }
}
